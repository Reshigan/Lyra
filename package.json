{
  "name": "lyra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "vitest",
    "e2e": "tsx e2e/global-setup.ts && playwright test",
    "eval": "pnpm --filter @lyra/model-gateway eval",
    "mutation": "pnpm --filter @lyra/core mutation && pnpm --filter @lyra/model-gateway mutation",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @lyra/db generate",
    "db:migrate": "pnpm --filter @lyra/db migrate",
    "deploy:staging": "pnpm --filter @lyra/api deploy:staging && pnpm --filter @lyra/web deploy:staging",
    "deploy:prod": "pnpm --filter @lyra/api deploy && pnpm --filter @lyra/web deploy",
    "seed": "pnpm --filter @lyra/core seed",
    "onprem:up": "docker compose -f ops/docker-compose.yml up -d",
    "onprem:down": "docker compose -f ops/docker-compose.yml down",
    "lyra": "tsx scripts/lyra.ts",
    "test:cli": "vitest run scripts",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.17.0",
    "@lyra/core": "workspace:*",
    "@lyra/db": "workspace:*",
    "@playwright/test": "^1.49.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=6.27.0",
      "ws": ">=8.21.0",
      "brace-expansion": ">=5.0.8",
      "sharp": ">=0.35.0",
      "vite": ">=6.4.3"
    }
  }
}
