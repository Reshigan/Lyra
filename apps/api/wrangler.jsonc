{
  // Deploy targets: `wrangler deploy` for production, `--env staging` for staging.
  // Secrets (ANTHROPIC_API_KEY, OPENAI_COMPAT_API_KEY) are set with
  // `wrangler secret put` — never in this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lyra-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  // DNS cutover for api.lyra.vantax.co.za confirmed live 2026-08-10 (valid
  // cert, 200 on /health) — the *.workers.dev fallback route is dead surface.
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    // "demo", not "production": this deployment is the showcase and carries
    // seeded demo data only. It opens the one-click persona doors on /login
    // (apps/api/src/auth.ts demoOnly) along with the demo clock and reseed
    // routes. Flip back to "production" the day a real tenant lands here —
    // password sign-in is unaffected either way.
    "ENVIRONMENT": "demo",
    "APP_ORIGIN": "https://lyra.vantax.co.za",
    "SESSION_COOKIE": "lyra_session"
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lyra",
      // Filled in by `wrangler d1 create lyra`; CI fails loudly if it is blank.
      "database_id": "e1f4ed16-86ee-49be-9c46-7c21915eccd2",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // KV was one namespace named "KV"; split into CACHE (same id, same data —
  // SSO nonces, rate-limit fallback) and CONFIG (new, tenant/domain-pack config).
  "kv_namespaces": [
    { "binding": "CACHE", "id": "d0e3a0b5e70f4bbbad797a0fdd9dbae0" },
    { "binding": "CONFIG", "id": "ff82d2eeb8ce4b9fb6bef1c4c4d1957e" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "lyra-files" },
    { "binding": "EXPORTS", "bucket_name": "lyra-exports" },
    { "binding": "LOGS", "bucket_name": "lyra-logs" }
  ],
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "lyra-events" }],
    "consumers": [{ "queue": "lyra-events", "max_batch_size": 25 }]
  },
  "vectorize": [
    { "binding": "VEC_KB", "index_name": "lyra-vec-kb" },
    { "binding": "VEC_MARKET", "index_name": "lyra-vec-market" },
    { "binding": "VEC_CONVO", "index_name": "lyra-vec-convo" }
  ],
  "analytics_engine_datasets": [{ "binding": "TELEMETRY", "dataset": "lyra_telemetry" }],
  "browser": { "binding": "BROWSER" },
  // docs/10 §2: day-0/7/21/30 renewal campaign (engines/renewal-workflow.ts),
  // one instance per orbit_renewals row (sweepRenewals, engines/renewals.ts).
  "workflows": [{ "binding": "WF", "name": "lyra-workflows", "class_name": "RenewalWorkflow" }],
  // docs/16 H3 / docs/02 §4: one AgentRoom per ORBIT conversation. RATE is one
  // instance per throttle key (auth.ts); REALTIME is one per user (SSE push).
  "durable_objects": {
    "bindings": [
      { "name": "AGENT_ROOM", "class_name": "AgentRoom" },
      { "name": "RATE", "class_name": "RateCounter" },
      { "name": "REALTIME", "class_name": "UserChannel" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AgentRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RateCounter", "UserChannel"] }
  ],
  // Outbox drain and session sweep. Both idempotent, so a missed tick only costs
  // latency.
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [{ "pattern": "api.lyra.vantax.co.za", "custom_domain": true }],
  "env": {
    "staging": {
      "name": "lyra-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_ORIGIN": "https://staging.lyra.vantax.co.za",
        "SESSION_COOKIE": "lyra_session"
      },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lyra-staging",
          "database_id": "81d1ede7-08fc-4941-a3aa-7e342bbbc0fb",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "kv_namespaces": [
        { "binding": "CACHE", "id": "fe4fd013a5ac4b9e8125c9c1301d3a5e" },
        { "binding": "CONFIG", "id": "99a71581517e4eb4bdfde38de06ded98" }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "lyra-files-staging" },
        { "binding": "EXPORTS", "bucket_name": "lyra-exports-staging" },
        { "binding": "LOGS", "bucket_name": "lyra-logs-staging" }
      ],
      "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "lyra-events-staging" }],
        "consumers": [{ "queue": "lyra-events-staging", "max_batch_size": 25 }]
      },
      "vectorize": [
        { "binding": "VEC_KB", "index_name": "lyra-vec-kb-staging" },
        { "binding": "VEC_MARKET", "index_name": "lyra-vec-market-staging" },
        { "binding": "VEC_CONVO", "index_name": "lyra-vec-convo-staging" }
      ],
      "analytics_engine_datasets": [{ "binding": "TELEMETRY", "dataset": "lyra_telemetry_staging" }],
      "browser": { "binding": "BROWSER" },
      "workflows": [{ "binding": "WF", "name": "lyra-workflows-staging", "class_name": "RenewalWorkflow" }],
      "durable_objects": {
        "bindings": [
          { "name": "AGENT_ROOM", "class_name": "AgentRoom" },
          { "name": "RATE", "class_name": "RateCounter" },
          { "name": "REALTIME", "class_name": "UserChannel" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["AgentRoom"] },
        { "tag": "v2", "new_sqlite_classes": ["RateCounter", "UserChannel"] }
      ],
      "triggers": { "crons": ["*/15 * * * *"] },
      "routes": [{ "pattern": "api-staging.lyra.vantax.co.za", "custom_domain": true }]
    }
  }
}
