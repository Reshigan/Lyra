{
  "expo": {
    "name": "Lyra",
    "slug": "lyra",
    "scheme": "lyra",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "co.za.vantax.lyra" },
    "android": { "package": "co.za.vantax.lyra", "edgeToEdgeEnabled": true },
    "plugins": ["expo-router", "expo-secure-store", "expo-localization"],
    "extra": { "router": {} },
    "experiments": { "typedRoutes": false }
  }
}
