{
  // Deploy targets: `wrangler deploy` for production, `--env staging` for staging.
  // The shell holds no secrets — it never talks to a provider, only to the API
  // over a session cookie the browser owns.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lyra-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  // DNS cutover for lyra.vantax.co.za confirmed live 2026-08-10 (valid cert,
  // 200 on /login) — the *.workers.dev fallback route is dead surface.
  "workers_dev": false,
  "observability": { "enabled": true },
  "assets": { "directory": "./build/client/" },
  "vars": {
    "ENVIRONMENT": "production",
    "API_ORIGIN": "https://api.lyra.vantax.co.za",
    "SESSION_COOKIE": "lyra_session",
    // Must match apps/api's SESSION_COOKIE_DOMAIN: the two clear-the-cookie
    // fallbacks here (logout.tsx, settings.tsx) clear nothing if their Domain
    // differs from the one the API set.
    "SESSION_COOKIE_DOMAIN": "lyra.vantax.co.za"
  },
  "routes": [{ "pattern": "lyra.vantax.co.za", "custom_domain": true }],
  "env": {
    "staging": {
      "name": "lyra-web-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "API_ORIGIN": "https://api-staging.lyra.vantax.co.za",
        // Must match apps/api's staging SESSION_COOKIE, and must differ from
        // production's: see the comment there.
        "SESSION_COOKIE": "lyra_session_staging",
        // Must match apps/api's SESSION_COOKIE_DOMAIN: the two clear-the-cookie
        // fallbacks here (logout.tsx, settings.tsx) clear nothing if their Domain
        // differs from the one the API set.
        "SESSION_COOKIE_DOMAIN": "lyra.vantax.co.za"
      },
      "routes": [{ "pattern": "staging.lyra.vantax.co.za", "custom_domain": true }]
    }
  }
}
