    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.115.0"
