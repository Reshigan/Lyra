# Copy to .env (compose) or .env.local (local dev). NEVER commit real values —
# .gitignore excludes every .env* except this file. Cloud secrets live in
# `wrangler secret put`; CI secrets live in GitHub Actions (docs/12 §1).

# ---------------------------------------------------------------- app runtime
# Free-form label surfaced by GET /health. local | onprem | staging | production
ENVIRONMENT=local
# Public origin of the web app. Used for CORS and cookie scoping — must match
# the browser's address bar exactly or login silently fails.
APP_ORIGIN=http://localhost:5173
# Name of the session cookie. Change only to avoid a clash on a shared domain.
SESSION_COOKIE=lyra_session
# Signing key for sessions and webhook signatures. 32+ random bytes.
# Generate with: openssl rand -base64 48
AUTH_SECRET=generate-a-long-random-string
# Port the Node (on-prem) server listens on inside its container.
APP_PORT=8787

# -------------------------------------------------------------- model gateway
# Cloudflare AI Gateway URL (docs/10 §3). Cloud only — leave blank on-prem so
# nothing is dialled outside the estate. Provider SDKs are never called direct.
AI_GATEWAY_URL=
# Anthropic key, cloud only. Set with `wrangler secret put ANTHROPIC_API_KEY`
# for deployed environments; this file is for local dev only.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Internal OpenAI-compatible model endpoint (vLLM or Ollama, docs/11 §2).
# Ollama: http://llm:11434/v1   vLLM: http://llm-vllm:8000/v1
OPENAI_COMPAT_URL=http://localhost:11434/v1
# Bearer token for the above. Usually blank on a private network.
OPENAI_COMPAT_API_KEY=

# ------------------------------------------------------------------- database
# libSQL/SQLite connection. `file:` for local dev and drizzle-kit, `http://`
# for the on-prem libsql-server. D1 is a binding, not a URL — cloud ignores this.
LIBSQL_URL=file:./.data/lyra.db
# Auth token for a remote libsql server. Blank for file: and for a server on a
# private network with no auth configured.
LIBSQL_AUTH_TOKEN=

# =============================================================================
# On-prem stack only (ops/docker-compose.yml). Ignore all of this for cloud.
# =============================================================================

# --------------------------------------------------------------- edge / caddy
# Hostname Caddy serves and requests a certificate for. Must resolve to this box.
LYRA_DOMAIN=lyra.internal.example
# Where Caddy forwards traffic. Change only if you rename the app service.
APP_UPSTREAM=app:8787
# Contact address for ACME/Let's Encrypt. Blank = internal self-signed CA.
ACME_EMAIL=
# Host ports Caddy publishes. Raise if 80/443 are already taken on the host.
HTTP_PORT=80
HTTPS_PORT=443

# ------------------------------------------------------------------- services
# Redis: BullMQ queues, rate counters, realtime pubsub (docs/11 §3).
REDIS_URL=redis://redis:6379
# Qdrant: the Vectorize replacement.
QDRANT_URL=http://qdrant:6333
# TEI embeddings service (bge-m3, ar+en).
EMBEDDINGS_URL=http://embed:80
# Headless Chromium for PDF board packs and page snapshots.
RENDER_URL=http://render:3000
# Shared token browserless requires on every connection. Any random string.
RENDER_TOKEN=REPLACE_ME
# Concurrent browser sessions. Raise only if the host has the RAM.
RENDER_CONCURRENT=2

# ------------------------------------------------------- object store (MinIO)
# S3 API endpoint standing in for R2.
S3_ENDPOINT=http://minio:9000
# Bucket for tenant files.
S3_BUCKET=lyra-files
# MinIO root credentials. Also used as the app's S3 access key pair.
MINIO_ROOT_USER=lyra
MINIO_ROOT_PASSWORD=REPLACE_ME_MIN_8_CHARS

# --------------------------------------------------------------- internal LLM
# Ollama is the default tier — no GPU required (docs/11 §2).
OLLAMA_IMAGE=ollama/ollama:latest
# vLLM, used only under the `gpu` compose profile.
VLLM_IMAGE=vllm/vllm-openai:latest
# HuggingFace repo id of the weights to serve. Required for the gpu profile.
VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Name the gateway addresses the model by. Maps to a tier in tenant policy.
VLLM_SERVED_NAME=lyra-standard
# On-prem briefs cap at 32k context (docs/11 §2).
VLLM_MAX_MODEL_LEN=32768
# Fraction of VRAM vLLM may claim.
VLLM_GPU_UTIL=0.92
# GPUs to reserve. 2 for 70B AWQ on A100/H100.
VLLM_GPU_COUNT=1
# Embedding model pulled by the TEI service.
EMBED_MODEL=BAAI/bge-m3

# ------------------------------------------------------------------- platform
# Tag of the built app image. Point at a registry tag for an air-gapped install.
LYRA_IMAGE=lyra/app:local
# Signed licence JWT, checked locally with no phone-home (docs/11 §1).
LYRA_LICENCE=
# OTLP endpoint. Blank disables export; set to http://otel:4318 with the
# `observability` profile running.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------- pinned images (offline)
# Overrides for an air-gapped install where images come from a local registry.
LIBSQL_IMAGE=ghcr.io/tursodatabase/libsql-server:latest
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:latest
QDRANT_IMAGE=qdrant/qdrant:latest
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-latest
RENDER_IMAGE=ghcr.io/browserless/chromium:latest
CADDY_IMAGE=caddy:2-alpine
OTEL_IMAGE=grafana/otel-lgtm:latest

# =============================================================================
# CI only — these are GitHub Actions repository secrets, NOT values for a file.
# Listed here so the required names are discoverable. Leave blank locally.
# =============================================================================
# Cloudflare account the workers deploy into.
CLOUDFLARE_ACCOUNT_ID=
# Scoped API token: Workers Scripts:Edit, D1:Edit, Workers KV:Edit, R2:Edit.
CLOUDFLARE_API_TOKEN=
