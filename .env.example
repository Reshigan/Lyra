# Copy to .env.local for local dev. NEVER commit real values.
ENVIRONMENT=local

# Model gateway. In staging/prod ANTHROPIC_BASE_URL points at the Cloudflare
# AI Gateway URL (docs/10 §3), never the provider directly.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# On-prem / openai-compat provider (vLLM or Ollama). docs/11.
OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
OPENAI_COMPAT_API_KEY=REPLACE_ME

# Auth
AUTH_SECRET=generate-a-long-random-string

# libSQL (on-prem + local node runtime). D1-local is the default for wrangler dev.
LIBSQL_URL=file:./.data/lyra.db
LIBSQL_AUTH_TOKEN=

# Cloudflare (CI only — store as GitHub Actions secrets, never here)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
